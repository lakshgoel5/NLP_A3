#!/bin/bash
#PBS -N Q1_baseline
#PBS -P col772.cs1230848.course
#PBS -l select=1:ncpus=4:ngpus=1:centos=skylake
#PBS -l walltime=03:30:00

set -e

export PATH=/home/apps/centos7/JAX_MD/bin:$PATH
export HF_TOKEN="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"
export WANDB_DISABLED=true

cd /home/cse/btech/cs1230848/HPC-IIT-Delhi
python3 iitdproxy.py proxyAuth.txt &

BASE=/home/cse/btech/cs1230848/NLP_A3
cd "$BASE/Q1"

OUTBASE=./output

echo "====== Training Q1 ======"
bash train.sh "$OUTBASE"

echo "====== Generating val splits ======"
python -u "$BASE/make_val_splits.py" --files "$BASE/sft_dataset/hi_train.jsonl" "$BASE/sft_dataset/kn_train.jsonl" --out_dir ./val_splits

echo "====== Inference Q1 ======"
bash infer.sh en  "$BASE/en_sft_dataset/valid.jsonl"   "$OUTBASE"
bash infer.sh hi  ./val_splits/hi_train_val.jsonl       "$OUTBASE"
bash infer.sh kn  ./val_splits/kn_train_val.jsonl       "$OUTBASE"

echo "====== Validate Q1 ======"
python -u "$BASE/validate_output.py" "$OUTBASE/Q1_en.jsonl" "$OUTBASE/Q1_hi.jsonl" "$OUTBASE/Q1_kn.jsonl"

echo "====== Evaluation Q1 ======"
python -u "$BASE/eval.py" "$OUTBASE/Q1_en.jsonl" "$BASE/en_sft_dataset/valid.jsonl"
python -u "$BASE/eval.py" "$OUTBASE/Q1_hi.jsonl" ./val_splits/hi_train_val.jsonl
python -u "$BASE/eval.py" "$OUTBASE/Q1_kn.jsonl" ./val_splits/kn_train_val.jsonl

echo "====== Q1 Done ======"
