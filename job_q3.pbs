#!/bin/bash
#PBS -N Q3_ICL
#PBS -P col772.cs1230848.course
#PBS -l select=1:ncpus=4:ngpus=1:mem=16G:centos=skylake
#PBS -l walltime=01:00:00
#PBS -q high

set -e

# Required for vllm + faiss-gpu environment
module load compiler/gcc/11.2.0

eval "$(conda shell.bash hook)"
conda deactivate
conda activate /home/scai/msr/aiy247541/.conda/envs/vllm_server_nlp

# Required for faiss-gpu to find CUDA runtime libs
export LD_LIBRARY_PATH=/home/scai/msr/aiy247541/.conda/envs/vllm_server_nlp/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:$LD_LIBRARY_PATH
export WANDB_DISABLED=true
export CUDA_VISIBLE_DEVICES=0

cd /home/cse/btech/cs1230848/HPC-IIT-Delhi
python3 iitdproxy.py proxyAuth.txt &

BASE=/home/cse/btech/cs1230848/NLP_A3/sub

# Install sklearn into the vllm env if not already present (eval.py needs it)
pip install -q scikit-learn

if [ ! -d "$BASE/h" ]; then
    echo "ERROR: $BASE/h not found. Please upload the h/ folder to the HPC first."
    exit 1
fi
cd "$BASE/Q3"

OUTDIR=./output
mkdir -p "$OUTDIR"

echo "====== Q3 ICL Inference ======"
bash infer.sh en  "$BASE/en_sft_dataset/valid.jsonl"    "$OUTDIR"
bash infer.sh hi  "$BASE/sft_dataset/hi_train.jsonl"    "$OUTDIR"
bash infer.sh kn  "$BASE/sft_dataset/kn_train.jsonl"    "$OUTDIR"
bash infer.sh or  "$BASE/sft_dataset/or_train.jsonl"    "$OUTDIR"
bash infer.sh tcy "$BASE/sft_dataset/tcy_val.jsonl"     "$OUTDIR"

echo "====== Validate Q3 ======"
python -u "$BASE/validate_output.py" "$OUTDIR/Q3_en.jsonl" "$OUTDIR/Q3_hi.jsonl" "$OUTDIR/Q3_kn.jsonl" "$OUTDIR/Q3_or.jsonl" "$OUTDIR/Q3_tcy.jsonl"

echo "====== Evaluation Q3 ======"
python -u "$BASE/eval.py" "$OUTDIR/Q3_en.jsonl"  "$BASE/en_sft_dataset/valid.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_hi.jsonl"  "$BASE/sft_dataset/hi_train.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_kn.jsonl"  "$BASE/sft_dataset/kn_train.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_or.jsonl"  "$BASE/sft_dataset/or_train.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_tcy.jsonl" "$BASE/sft_dataset/tcy_val.jsonl"

echo "====== Q3 Done ======"
