#!/bin/bash
#PBS -N Q3_ICL
#PBS -P col772.cs1230848.course
#PBS -l select=1:ncpus=8:ngpus=1:mem=32G:centos=skylake
#PBS -l walltime=01:00:00

set -e

# Required for vllm + faiss-gpu environment
module load compiler/gcc/11.2.0

eval "$(conda shell.bash hook)"
conda deactivate
conda activate /home/scai/msr/aiy247541/.conda/envs/vllm_server_nlp

# Required for faiss-gpu to find CUDA runtime libs
export LD_LIBRARY_PATH=/home/scai/msr/aiy247541/.conda/envs/vllm_server_nlp/lib/python3.10/site-packages/nvidia/cuda_runtime/lib:$LD_LIBRARY_PATH
export WANDB_DISABLED=true
export CUDA_VISIBLE_DEVICES=0

cd /home/cse/btech/cs1230848/HPC-IIT-Delhi
python3 iitdproxy.py proxyAuth.txt &

BASE=/home/cse/btech/cs1230848/NLP_A3

# Install sklearn into the vllm env if not already present (eval.py needs it)
pip install -q scikit-learn

if [ ! -d "$BASE/h" ]; then
    echo "ERROR: $BASE/h not found. Please upload the h/ folder to the HPC first."
    exit 1
fi
cd "$BASE/Q3"

OUTDIR=./output
mkdir -p "$OUTDIR"

echo "====== Q3 ICL Inference ======"
# English: valid.jsonl is separate from the English demo pool — no leakage
python -u infer2.py --lang en  --test_file "$BASE/en_sft_dataset/valid.jsonl" --output_dir "$OUTDIR"
# Indic: --holdout_eval splits train 80/20; 80% goes into demo pool, 20% used as test
# This avoids testing on data that is itself a demo — saves holdout_ref_{lang}.jsonl for eval
python -u infer2.py --lang hi  --output_dir "$OUTDIR" --holdout_eval
python -u infer2.py --lang kn  --output_dir "$OUTDIR" --holdout_eval
python -u infer2.py --lang or  --output_dir "$OUTDIR" --holdout_eval
python -u infer2.py --lang tcy --output_dir "$OUTDIR" --holdout_eval

echo "====== Validate Q3 ======"
python -u "$BASE/validate_output.py" "$OUTDIR/Q3_en.jsonl" "$OUTDIR/Q3_hi.jsonl" "$OUTDIR/Q3_kn.jsonl" "$OUTDIR/Q3_or.jsonl" "$OUTDIR/Q3_tcy.jsonl"

echo "====== Evaluation Q3 ======"
python -u "$BASE/eval.py" "$OUTDIR/Q3_en.jsonl"  "$BASE/en_sft_dataset/valid.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_hi.jsonl"  "$OUTDIR/holdout_ref_hi.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_kn.jsonl"  "$OUTDIR/holdout_ref_kn.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_or.jsonl"  "$OUTDIR/holdout_ref_or.jsonl"
python -u "$BASE/eval.py" "$OUTDIR/Q3_tcy.jsonl" "$OUTDIR/holdout_ref_tcy.jsonl"

echo "====== Q3 Done ======"

