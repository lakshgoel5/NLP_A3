#!/bin/bash
#PBS -N Q1_pre_adapt
#PBS -P col772.cs1230848.course
#PBS -l select=1:ncpus=4:ngpus=1:centos=skylake
#PBS -l walltime=05:00:00

export PATH=/home/apps/centos7/JAX_MD/bin:$PATH
export HF_TOKEN="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"
export WANDB_DISABLED=true

cd /home/cse/btech/cs1230848/HPC-IIT-Delhi
python3 iitdproxy.py proxyAuth.txt &

BASE=/home/cse/btech/cs1230848/NLP_A3
cd "$BASE/Q1"

OUTBASE=./output
FINAL_MODEL="$OUTBASE/re_finetuned_pre"

echo "====== Training Q1 (pre_adapt) ======"
bash train.sh "$OUTBASE" pre_adapt

echo "====== Generating val splits ======"
python -u "$BASE/make_val_splits.py" \
    --files "$BASE/sft_dataset/hi_train.jsonl" \
            "$BASE/sft_dataset/kn_train.jsonl" \
    --out_dir ./val_splits

echo "====== Inference Q1 ======"
bash infer.sh en  "$BASE/en_sft_dataset/valid.jsonl"   "$FINAL_MODEL"
bash infer.sh hi  ./val_splits/hi_train_val.jsonl       "$FINAL_MODEL"
bash infer.sh kn  ./val_splits/kn_train_val.jsonl       "$FINAL_MODEL"

echo "====== Evaluation Q1 ======"
python -u "$BASE/eval.py" "$FINAL_MODEL/output_en.jsonl" "$BASE/en_sft_dataset/valid.jsonl"
python -u "$BASE/eval.py" "$FINAL_MODEL/output_hi.jsonl" ./val_splits/hi_train_val.jsonl
python -u "$BASE/eval.py" "$FINAL_MODEL/output_kn.jsonl" ./val_splits/kn_train_val.jsonl

echo "====== Q1 Done ======"
